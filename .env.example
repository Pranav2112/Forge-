# Pooled Postgres URL for the running app. DIRECT_URL is the session URL used by Prisma migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Optional. Free key from https://fdc.nal.usda.gov/api-key.html
# You can also paste the key into Settings. It stays on this machine.
USDA_API_KEY=""

# Progress photos are served only for local development unless this is true.
# Leave it false on any public deploy until you add real authentication.
FORGE_PRIVATE_DEPLOYMENT="false"

# Supabase Auth. Leave blank for local single-user use.
# On Vercel these are required. The app serves no records until they are set.
NEXT_PUBLIC_SUPABASE_URL=""
# Modern publishable key. The legacy anon key name is still accepted by the app.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# The only email allowed to sign in. Not a password.
ALLOWED_EMAIL=""
# Server-only. Used once to activate the existing owner account. Never use a NEXT_PUBLIC_ name.
SUPABASE_SERVICE_ROLE_KEY=""
# Set true on any public host that is not Vercel.
FORGE_REQUIRE_AUTH="false"
# Supabase Postgres connection string. Not used by local SQLite.
POSTGRES_URL=""
